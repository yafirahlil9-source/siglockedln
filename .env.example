NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DATA_DIR=./data
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Optional dedicated key for encrypting biometric templates at rest.
BIOMETRIC_KEY=
BCRYPT_COST=12
# Keep false on public deployments so admins can approve registrations.
AUTO_ACTIVATE_ACCOUNTS=false

# Database MySQL (XAMPP / Laragon / Standalone)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sekolah_hub

# Google Cloud OAuth Web Client settings; required when NODE_ENV=production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# A unique initial admin. Change this before first startup.
SEED_ADMIN_EMAIL=admin@school.example
SEED_ADMIN_PASSWORD=replace-with-a-strong-unique-password
